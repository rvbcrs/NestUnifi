+func (s *Subscriber) report(err error) {
+	if s.Report == nil {
+		return
+	}
+	outcome := "ok"
+	if err != nil {
+		outcome = err.Error()
+	}
+	if outcome != s.reported {
+		s.reported = outcome
+		s.Report(err)
+	}
+}
