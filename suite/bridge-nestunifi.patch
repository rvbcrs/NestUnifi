+++ b/internal/media/nestunifi_test.go
@@ -0,0 +1,135 @@
+package media_test
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5"
+	"github.com/bluenviron/gortsplib/v5/pkg/base"
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ceb3/nest-to-ONVIF/internal/config"
+	"github.com/ceb3/nest-to-ONVIF/internal/media"
+	"github.com/ceb3/nest-to-ONVIF/internal/session"
+)
+
+// paths records what every path of a test server was given. A refused path answers its ANNOUNCE with an error.
+type paths struct {
+	mu      sync.Mutex
+	medias  map[string][]description.MediaType
+	packets map[string]int
+	refused string
+}
+
+func (p *paths) OnAnnounce(ctx *gortsplib.ServerHandlerOnAnnounceCtx) (*base.Response, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if ctx.Path == p.refused {
+		return &base.Response{StatusCode: base.StatusNotFound}, assert.AnError
+	}
+	for _, medium := range ctx.Description.Medias {
+		p.medias[ctx.Path] = append(p.medias[ctx.Path], medium.Type)
+	}
+	return &base.Response{StatusCode: base.StatusOK}, nil
+}
+
+func (p *paths) OnSetup(*gortsplib.ServerHandlerOnSetupCtx) (*base.Response, *gortsplib.ServerStream, error) {
+	return &base.Response{StatusCode: base.StatusOK}, nil, nil
+}
+
+func (p *paths) OnRecord(ctx *gortsplib.ServerHandlerOnRecordCtx) (*base.Response, error) {
+	path := ctx.Path
+	ctx.Session.OnPacketRTPAny(func(*description.Media, format.Format, *rtp.Packet) {
+		p.mu.Lock()
+		p.packets[path]++
+		p.mu.Unlock()
+	})
+	return &base.Response{StatusCode: base.StatusOK}, nil
+}
+
+func (p *paths) seen(path string) ([]description.MediaType, int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.medias[path], p.packets[path]
+}
+
+func soundServer(t *testing.T, refused string) (string, *paths) {
+	t.Helper()
+	seen := &paths{medias: map[string][]description.MediaType{}, packets: map[string]int{}, refused: refused}
+	server := &gortsplib.Server{Handler: seen, RTSPAddress: "127.0.0.1:0"}
+	require.NoError(t, server.Start())
+	t.Cleanup(server.Close)
+	return "rtsp://" + server.NetListener().Addr().String(), seen
+}
+
+func send(t *testing.T, sink session.TrackSink, track session.TrackInfo, payloadType uint8, sequence uint16) {
+	t.Helper()
+	require.NoError(t, sink.WriteRTP(track, &rtp.Packet{
+		Header:  rtp.Header{PayloadType: payloadType, SequenceNumber: sequence},
+		Payload: []byte{0x65},
+	}))
+}
+
+func TestSoundIsPublishedBesideTheVideo(t *testing.T) {
+	baseURL, seen := soundServer(t, "")
+	sink, err := media.WithSound(config.Camera{Name: "Backyard"}, baseURL)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sink.(session.SinkCloser).Close() })
+
+	for sequence := uint16(0); sequence < 3; sequence++ {
+		send(t, sink, videoTrack, 96, sequence)
+		send(t, sink, audioTrack, 111, sequence)
+	}
+	require.Eventually(t, func() bool {
+		_, video := seen.seen("/cam-backyard")
+		_, sound := seen.seen("/cam-backyard-audio")
+		return video == 3 && sound == 3
+	}, 2*time.Second, 10*time.Millisecond)
+	video, _ := seen.seen("/cam-backyard")
+	sound, _ := seen.seen("/cam-backyard-audio")
+	assert.Equal(t, []description.MediaType{description.MediaTypeVideo}, video)
+	assert.Equal(t, []description.MediaType{description.MediaTypeAudio}, sound)
+	assert.Equal(t, uint64(3), sink.(session.SinkReporter).SinkStats().Published)
+}
+
+func TestVideoGoesOnWhenTheSoundIsRefused(t *testing.T) {
+	baseURL, seen := soundServer(t, "/cam-backyard-audio")
+	sink, err := media.WithSound(config.Camera{Name: "Backyard"}, baseURL)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sink.(session.SinkCloser).Close() })
+
+	for sequence := uint16(0); sequence < 3; sequence++ {
+		send(t, sink, audioTrack, 111, sequence)
+		send(t, sink, videoTrack, 96, sequence)
+	}
+	require.Eventually(t, func() bool {
+		_, video := seen.seen("/cam-backyard")
+		return video == 3
+	}, 2*time.Second, 10*time.Millisecond)
+	medias, sound := seen.seen("/cam-backyard-audio")
+	assert.Empty(t, medias)
+	assert.Zero(t, sound)
+	assert.Zero(t, sink.(session.SinkReporter).SinkStats().Failed)
+}
+
+func TestCameraConfiguredWithAudioKeepsOnePath(t *testing.T) {
+	baseURL, seen := soundServer(t, "")
+	sink, err := media.WithSound(config.Camera{Name: "Backyard", Audio: true}, baseURL)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sink.(session.SinkCloser).Close() })
+
+	send(t, sink, videoTrack, 96, 0)
+	send(t, sink, audioTrack, 111, 0)
+	send(t, sink, videoTrack, 96, 1)
+	require.Eventually(t, func() bool {
+		medias, _ := seen.seen("/cam-backyard")
+		return len(medias) == 2
+	}, 2*time.Second, 10*time.Millisecond)
+	medias, _ := seen.seen("/cam-backyard-audio")
+	assert.Empty(t, medias)
+}
