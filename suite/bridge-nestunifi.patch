+	"github.com/stretchr/testify/require"
+
+	"github.com/ceb3/nest-to-ONVIF/internal/config"
+)
+
+func TestSubscriberReportsEachChangeOfOutcomeOnce(t *testing.T) {
+	stub := newPubSubStub()
+	stub.failNext = true
+	s := runSubscriber(t, stub, []string{testDeviceOne}, func(Event) {})
+	s.ErrorDelay = time.Millisecond
+
+	var mu sync.Mutex
+	var seen []bool
+	s.Report = func(err error) {
+		mu.Lock()
+		seen = append(seen, err == nil)
+		mu.Unlock()
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { defer close(done); s.Run(ctx) }()
+	for i := 0; i < 3; i++ { // the pulls after the failure all succeed
+		select {
+		case <-stub.pulled:
+		case <-time.After(2 * time.Second):
+			t.Fatal("subscriber did not pull")
+		}
+	}
+	cancel()
+	<-done
+
+	mu.Lock()
+	defer mu.Unlock()
+	assert.Equal(t, []bool{false, true}, seen)
+}
+
+func TestStatusFileHoldsTheLatestOutcome(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "events.json")
+	report := StatusFile(path)
+
+	report(errors.New("pubsub: HTTP 403 (PERMISSION_DENIED)"))
+	raw, err := os.ReadFile(path)
+	require.NoError(t, err)
+	assert.JSONEq(t, `{"ok":false,"error":"pubsub: HTTP 403 (PERMISSION_DENIED)"}`, string(raw))
+
+	report(nil)
+	raw, err = os.ReadFile(path)
+	require.NoError(t, err)
+	assert.JSONEq(t, `{"ok":true}`, string(raw))
+
+	StatusFile("")(nil) // nowhere to report to
+}
+
+func TestTriggerReportsTheKindOfDetection(t *testing.T) {
+	var got string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got = r.Method + " " + r.URL.Path + "?" + r.URL.RawQuery
+	}))
+	t.Cleanup(srv.Close)
+
+	tr := NewTrigger(WithTriggerHTTPClient(srv.Client()), WithTriggerBaseURL(srv.URL))
+	cam := config.Camera{Name: "Front door", ONVIF: config.ONVIFConfig{IP: "192.0.2.9"}}
+	require.NoError(t, tr.Report(context.Background(), cam, KindChime))
+	assert.Equal(t, "POST /trigger/event?kind=chime", got)
+}
