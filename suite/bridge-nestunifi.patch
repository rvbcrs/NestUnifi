diff --git a/internal/media/nestunifi.go b/internal/media/nestunifi.go
new file mode 100644
index 0000000..22f8a1c
--- /dev/null
+++ b/internal/media/nestunifi.go
@@ -0,0 +1,73 @@
+package media
+
+import (
+	"log/slog"
+	"sync/atomic"
+
+	"github.com/pion/rtp"
+	"github.com/pion/webrtc/v4"
+
+	"github.com/ceb3/nest-to-ONVIF/internal/config"
+	"github.com/ceb3/nest-to-ONVIF/internal/session"
+)
+
+// SoundSuffix follows a camera's path to name the path its sound is published on.
+const SoundSuffix = "-audio"
+
+// sounded publishes a camera's video on its own path, exactly as without sound, and its sound on a second path.
+// A recorder reads the camera's path and UniFi Protect does not accept Opus, so the sound stays out of it.
+// Whatever happens to the sound, the video goes on.
+type sounded struct {
+	video, sound *Publisher
+	silent       atomic.Bool
+	log          *slog.Logger
+}
+
+var (
+	_ session.TrackSink    = (*sounded)(nil)
+	_ session.SinkCloser   = (*sounded)(nil)
+	_ session.SinkReporter = (*sounded)(nil)
+)
+
+// WithSound gives the publisher of one camera connection. A camera configured with audio keeps both on one path.
+func WithSound(cam config.Camera, baseURL string) (session.TrackSink, error) {
+	video, err := NewPublisher(cam, baseURL)
+	if err != nil {
+		return nil, err
+	}
+	if cam.Audio {
+		return video, nil
+	}
+	beside := cam
+	beside.Name += SoundSuffix
+	sound, err := NewPublisher(beside, baseURL)
+	if err != nil {
+		return nil, err
+	}
+	sound.wantAudio, sound.soundOnly = true, true
+	return &sounded{video: video, sound: sound, log: sound.log}, nil
+}
+
+func (s *sounded) WriteRTP(info session.TrackInfo, pkt *rtp.Packet) error {
+	if info.Kind != webrtc.RTPCodecTypeAudio {
+		return s.video.WriteRTP(info, pkt)
+	}
+	if s.silent.Load() {
+		return nil
+	}
+	if err := s.sound.WriteRTP(info, pkt); err != nil && !s.silent.Swap(true) {
+		s.log.Warn("sound is not published for this connection; video goes on", "error", err)
+		_ = s.sound.Close()
+	}
+	return nil
+}
+
+// SinkStats reports the video alone: a connection is judged by its video.
+func (s *sounded) SinkStats() session.SinkStats {
+	return s.video.SinkStats()
+}
+
+func (s *sounded) Close() error {
+	_ = s.sound.Close()
+	return s.video.Close()
+}
