diff --git a/internal/events/nestunifi.go b/internal/events/nestunifi.go
new file mode 100644
index 0000000..ffdd8ca
--- /dev/null
+++ b/internal/events/nestunifi.go
@@ -0,0 +1,64 @@
+package events
+
+// Additions for NestUnifi, which runs this bridge next to its own admin page.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+
+	"github.com/ceb3/nest-to-ONVIF/internal/config"
+)
+
+// StatusFile returns a Subscriber.Report function that keeps path in step with
+// whether the subscription can be read. An empty path reports nowhere.
+func StatusFile(path string) func(error) {
+	return func(err error) {
+		if path == "" {
+			return
+		}
+		state := struct {
+			OK    bool   `json:"ok"`
+			Error string `json:"error,omitempty"`
+		}{OK: err == nil}
+		if err != nil {
+			state.Error = err.Error()
+		}
+		raw, _ := json.Marshal(state)
+		if os.WriteFile(path+".tmp", raw, 0o600) == nil {
+			_ = os.Rename(path+".tmp", path)
+		}
+	}
+}
+
+// Report tells a camera's own endpoint which detection arrived. Deliver carries
+// only the motion level, and that stays up while a doorbell press follows a
+// person, so every detection is reported on its own.
+func (t *Trigger) Report(ctx context.Context, cam config.Camera, kind Kind) error {
+	base := t.baseURL
+	if base == "" {
+		base = "http://" + cam.ONVIF.IP
+	}
+	ctx, cancel := context.WithTimeout(ctx, defaultTriggerTimeout)
+	defer cancel()
+
+	reqURL := base + "/trigger/event?" + url.Values{"kind": {string(kind)}}.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, reqURL, nil)
+	if err != nil {
+		return fmt.Errorf("build report request: %w", err)
+	}
+	resp, err := t.http.Do(req)
+	if err != nil {
+		return fmt.Errorf("post report: %w", err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("report returned HTTP %d", resp.StatusCode)
+	}
+	return nil
+}
